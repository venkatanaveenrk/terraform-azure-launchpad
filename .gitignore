# Terraform state — never commit
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Variable files with real values — never commit
terraform.tfvars
*.auto.tfvars

# Keys and certs — never commit
*.pem
*.pfx
*.p12
*.key

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Outputs
outputs.json
